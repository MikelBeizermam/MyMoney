// Copy this file to Config/Config.xcconfig and fill in your Supabase project values.
// Config.xcconfig is git-ignored so keys never reach the repository.
//
// Note: "//" starts a comment in xcconfig files, so the URL is written as https:/$()/...
SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-OR-PUBLISHABLE-KEY
